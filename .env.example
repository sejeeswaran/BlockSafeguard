# BlockSafeguard Environment Variables
# Copy this file to .env and fill in your actual values.

# Firebase Web API Key (from Firebase Console > Project Settings > General > Web API Key)
FIREBASE_API_KEY=your_firebase_api_key_here

# Firebase Configuration
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Service Account JSON file path
FIREBASE_SERVICE_ACCOUNT=your-service-account-file.json

# Blockchain / Web3 Configuration
INFURA_URL=https://sepolia.infura.io/v3/your_infura_project_id
CONTRACT_ADDRESS=0xYourContractAddress
WALLET_ADDRESS=0xYourWalletAddress
WALLET_PRIVATE_KEY=your_wallet_private_key

# AWS NACL Configuration
AWS_NACL_ID=acl-xxxxxxxxxxxxxxxxx
AWS_REGION=ap-south-1

# Flask Configuration
FLASK_PORT=5000
FLASK_SECRET_KEY=your_flask_secret_key_here
